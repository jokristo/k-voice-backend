database_url=sqlite:///./kvoice.db
access_token_expire_minutes=30
refresh_token_expire_minutes=10080
storage_local_path=storage
cors_origins=["http://localhost:3000"]

# --- OpenAI : transcription (Whisper) + résumé (GPT-4o-mini) ---
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1
NLP_PROVIDER=openai
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# --- Gemini (alternative) ---
# GEMINI_API_KEY=your-gemini-api-key-here
# DEFAULT_AI_MODEL=gemini-2.5-flash-lite

# --- Transcription locale (alternative gratuite) ---
# TRANSCRIPTION_PROVIDER=local
# LOCAL_WHISPER_MODEL_SIZE=base
# LOCAL_WHISPER_LANGUAGE=fr
# LOCAL_WHISPER_DEVICE=cpu
