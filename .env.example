# Copier vers .env en local — sur Render, définir ces variables dans le dashboard

# Dev local (SQLite)
database_url=sqlite:///./kvoice.db
# Prod Render (PostgreSQL — Internal Database URL)
# DATABASE_URL=postgresql://kvoice:xxx@dpg-xxx/kvoice
secret_key=change-me-in-production
access_token_expire_minutes=30
refresh_token_expire_minutes=10080
storage_local_path=storage
cors_origins=["http://localhost:3000"]

TRANSCRIPTION_PROVIDER=openai
NLP_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini

MAX_UPLOAD_SIZE_MB=100
AUDIO_COMPRESSION_ENABLED=true
AUDIO_COMPRESSION_TARGET_MB=24
AUDIO_COMPRESSION_MIN_KBPS=64
AUDIO_COMPRESSION_MAX_KBPS=128

# Premier déploiement Render (une fois)
RUN_BOOTSTRAP=true
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=

# PayPal (abonnements) — le Client ID doit être celui de l’app où les plans P-… ont été créés
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID_ESSENTIEL=P-9JW052881K6990917NINPJMI
PAYPAL_PLAN_ID_AVANCE=P-75V114236B1696345NINPM6A
# Webhook (dashboard PayPal → Webhooks → ID). Voir PAYPAL_WEBHOOKS.md
PAYPAL_WEBHOOK_ID=
# PAYPAL_WEBHOOK_SKIP_VERIFY=true
